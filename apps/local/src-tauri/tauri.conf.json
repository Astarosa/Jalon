{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jalon",
  "version": "1.2.0",
  "identifier": "fr.jalon.local",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jalon",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Jalon",
    "shortDescription": "Jalon — suivi de chantier, édition locale",
    "copyright": "Usage interne",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Astarosa/Jalon/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzMDM4MEEwODZCRDQ4RkIKUldUN1NMMkdvSUFEbzV0VDFyRHZQZkd4cE9zMnVrK1R6dHpwL21DY0FySHVWR2NEUVh5alhKQTQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
